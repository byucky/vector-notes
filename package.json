{
  "name": "vector-notes",
  "version": "0.0.0",
  "main": "main.js",
  "scripts": {
    "build:electron": "tsc -p tsconfig.electron.json",
    "renderer:dev": "vite --config renderer/vite.config.ts",
    "renderer:build": "vite build --config renderer/vite.config.ts",
    "renderer:preview": "vite preview --config renderer/vite.config.ts",
    "electron": "npm run build:electron && npm run renderer:build && electron .",
    "start": "npm run renderer:dev",
    "build": "npm run renderer:build",
    "watch": "vite build --watch --config renderer/vite.config.ts",
    "test:db": "jest tests/db.test.ts",
    "test:vector": "jest tests/vector-search.test.ts",
    "test:all": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "private": true,
  "dependencies": {
    "@duckdb/node-api": "^1.3.2-alpha.26",
    "openai": "^5.15.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rxjs": "~7.8.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^37.2.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.8.3",
    "vite": "^6.4.1"
  }
}
